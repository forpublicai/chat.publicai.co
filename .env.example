# Copy to .env and fill in. Never commit .env.

# Your Public AI developer key, from https://platform.publicai.co
# Unset (or empty): the real per-partner config is untouched and nothing responds —
# this matches real production, which has no free/offline model either.
# Set: every OpenAI-compatible model is redirected through api.publicai.co instead.
PUBLICAI_API_KEY=

# Any string you like; OpenWebUI and your curl commands use it to talk to your local LiteLLM
LITELLM_MASTER_KEY=sk-local-dev

# Only needed for docker-compose.dev-openwebui.yml (hot-reload overlay). Path to a
# local clone of https://github.com/forpublicai/open-webui, relative to this repo's
# root. Defaults to a sibling checkout (../open-webui) if unset.
# OPENWEBUI_SRC=../open-webui

# Only needed for docker-compose.dev-litellm.yml (hot-reload overlay). Path to a
# local clone of https://github.com/BerriAI/litellm, relative to this repo's
# root. Defaults to a sibling checkout (../litellm) if unset.
# LITELLM_SRC=../litellm
