# Copy to .env and fill in. Never commit .env.

# Your Public AI developer key, from https://platform.publicai.co
# Used directly by litellm-config.yaml (hand-written config). Once the real
# rendered config is in use (Tasks 6-9), setting this also redirects every
# deployment through api.publicai.co instead of just the offline mock.
PUBLICAI_API_KEY=

# Any string you like; OpenWebUI and your curl commands use it to talk to your local LiteLLM
LITELLM_MASTER_KEY=sk-local-dev
